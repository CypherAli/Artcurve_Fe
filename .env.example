# ─────────────────────────────────────────────────────────────────
#  ArtCurve Frontend — Environment Variables
#  Copy sang .env.local và điền giá trị thực
# ─────────────────────────────────────────────────────────────────

# Backend API URL (bắt buộc)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# WalletConnect Project ID (bắt buộc cho RainbowKit)
# Lấy tại: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id-here

# Chain ID (8453 = Base mainnet, 84532 = Base Sepolia testnet)
NEXT_PUBLIC_CHAIN_ID=84532

# URL của site (dùng cho SIWE domain validation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket Hub URL (real-time price updates)
NEXT_PUBLIC_WS_HUB_URL=ws://localhost:8080

# LiveKit URL (live streaming)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

# Gemini API Key (guild AI chat — optional)
NEXT_PUBLIC_GEMINI_API_KEY=
